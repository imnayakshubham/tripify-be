# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# LLM — free tier at https://console.groq.com
GROQ_API_KEY=
# Optional; defaults to llama-3.3-70b-versatile
GROQ_MODEL=

# Postgres. Free tier at https://neon.tech
# Holds both the LangGraph checkpoints and the audit tables.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated origins allowed to call the API.
# Defaults to the Vite dev server if unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used by the Streamlit UI to find the API.
API_BASE_URL=http://127.0.0.1:8000
